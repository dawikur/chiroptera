#!/usr/bin/env python3
# Copyright (c) 2026 Dawid Kurek <hello@dawikur.dev>
"""Generate palette data and examples consumed by the documentation page."""

from __future__ import annotations

import json
import sys
import textwrap
from importlib import import_module
from pathlib import Path
from textwrap import dedent
from typing import Callable, cast

import numpy as np
import skimage.color
from numpy.typing import NDArray
from pygments import highlight
from pygments.formatters.html import HtmlFormatter
from pygments.lexer import Lexer
from pygments.style import Style
from pygments.token import Comment, Keyword, Name, Number, String, Text

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_DIR = SCRIPT_DIR.parent

sys.path.insert(0, str(REPO_DIR))
from chiroptera.palette import (  # pylint: disable=wrong-import-position
    Contrast,
    Mode,
    Palette,
)
from chiroptera.scheme import Scheme  # pylint: disable=wrong-import-position
from chiroptera.utils import (  # pylint: disable=wrong-import-position
    format_lines,
    palette_tokens,
)

_lexers = import_module("pygments.lexers")
BashLexer = cast(type[Lexer], getattr(_lexers, "BashLexer"))
VimLexer = cast(type[Lexer], getattr(_lexers, "VimLexer"))

RGB2LAB = cast(Callable[[object], NDArray[np.float64]], skimage.color.rgb2lab)

COLOR_NAMES = (
    "bg.dim",
    "bg",
    "bg.bright",
    "fg.dim",
    "fg",
    "fg.bright",
    "red.dim",
    "red",
    "red.bright",
    "yellow.dim",
    "yellow",
    "yellow.bright",
    "green.dim",
    "green",
    "green.bright",
    "cyan.dim",
    "cyan",
    "cyan.bright",
    "blue.dim",
    "blue",
    "blue.bright",
    "magenta.dim",
    "magenta",
    "magenta.bright",
)

CSS_COLORS = {
    "bg": "bg",
    "panel": "bg.bright",
    "ink": "fg.bright",
    "copy": "fg",
    "muted": "fg.dim",
    "accent": "cyan.bright",
    "accent-warm": "yellow.bright",
}

COMMAND_SAMPLES = {
    "inspect": "chiroptera --dark --name '^(bg|fg|red.bright)$'\n",
    "render": (
        "chiroptera --light --soft \\\n"
        "  --template ~/.config/my-app/theme.conf.tmpl \\\n"
        "  --output ~/.config/my-app/theme.conf\n"
    ),
}


def palette_data() -> dict[str, dict[str, dict[str, str]]]:
    """Return every generated palette variant as serializable hex data."""
    return {
        mode.value: {
            contrast.value: {
                name: str(Palette(mode, contrast)[name]["hex"]) for name in COLOR_NAMES
            }
            for contrast in Contrast
        }
        for mode in Mode
    }


def lab_data(
    palettes: dict[str, dict[str, dict[str, str]]],
) -> dict[str, dict[str, dict[str, dict[str, float]]]]:
    """Return CIE LAB values for every documentation palette color."""

    def hex_to_lab(hex_color: str) -> dict[str, float]:
        rgb = [int(hex_color[index : index + 2], 16) / 255 for index in (1, 3, 5)]
        lab: NDArray[np.float64] = RGB2LAB([[rgb]])
        lightness = cast(float, lab[0][0][0])
        a_axis = cast(float, lab[0][0][1])
        b_axis = cast(float, lab[0][0][2])
        return {
            "l": round(float(lightness), 1),
            "a": round(float(a_axis), 1),
            "b": round(float(b_axis), 1),
        }

    return {
        mode: {
            contrast: {
                name: hex_to_lab(hex_color) for name, hex_color in palette.items()
            }
            for contrast, palette in contrasts.items()
        }
        for mode, contrasts in palettes.items()
    }


def write_palette_css(output: Path, palette: dict[str, str]) -> None:
    """Write the initial CSS variables from the default dark palette."""
    variables = "\n".join(
        f"\t--{css_name}: {palette[palette_name]};"
        for css_name, palette_name in CSS_COLORS.items()
    )
    _ = output.write_text(
        dedent(
            f"""\
            /* Generated by scripts/generate_site; do not edit. */
            :root {{
            {variables}
            \t--border: color-mix(in srgb, var(--ink) 16%, transparent);
            \t--shadow: rgba(0, 0, 0, 0.34);
            \tcolor-scheme: dark;
            }}
        """
        ),
        encoding="utf-8",
    )


def vim_tokens(mode: Mode, contrast: Contrast) -> dict[str, str]:
    """Return template tokens for one palette variant."""
    palette = Palette(mode, contrast)
    scheme = Scheme(palette)
    return palette_tokens(palette, scheme, mode, contrast)


def vim_formatter(palette: Palette) -> HtmlFormatter[str]:
    """Return a Vim formatter whose syntax colors match ``palette``."""
    vim_style = type(
        "ChiropteraVimStyle",
        (Style,),
        {
            "default_style": "",
            "styles": {
                Comment: f"italic {palette['fg.dim']['hex']}",
                Text: str(palette["fg"]["hex"]),
                Keyword: str(palette["red.bright"]["hex"]),
                Name: str(palette["blue.bright"]["hex"]),
                Name.Variable: str(palette["magenta.bright"]["hex"]),
                Number: str(palette["cyan.bright"]["hex"]),
                String: str(palette["green.bright"]["hex"]),
            },
        },
    )
    return HtmlFormatter(nowrap=True, noclasses=True, style=vim_style)


def write_vim_sample(output_dir: Path) -> None:
    """Write palette-aware highlighted Vim template samples for the site."""
    template = (output_dir / "sample_tmpl.vim").read_text(encoding="utf-8")
    samples: dict[str, dict[str, dict[str, str]]] = {}
    default_rendered = ""
    for mode in Mode:
        samples[mode.value] = {}
        for contrast in Contrast:
            palette = Palette(mode, contrast)
            rendered = "".join(
                format_lines(template.splitlines(True), vim_tokens(mode, contrast))
            )
            samples[mode.value][contrast.value] = {
                "template": highlight(template, VimLexer(), vim_formatter(palette)),
                "generated": highlight(rendered, VimLexer(), vim_formatter(palette)),
                "inspect": highlight(
                    COMMAND_SAMPLES["inspect"], BashLexer(), vim_formatter(palette)
                ),
                "render": highlight(
                    COMMAND_SAMPLES["render"], BashLexer(), vim_formatter(palette)
                ),
            }
            if mode is Mode.DARK and contrast is Contrast.NORMAL:
                default_rendered = rendered
    _ = (output_dir / "generated-sample.vim").write_text(
        default_rendered, encoding="utf-8"
    )
    _ = (output_dir / "generated-sample.js").write_text(
        dedent(
            f"""\
        // Generated by scripts/generate_site; do not edit.
        window.CHIROPTERA_VIM_SAMPLES = {json.dumps(samples)};
        """
        ),
        encoding="utf-8",
    )


def main() -> int:
    """Write a small browser-consumable JavaScript data file."""
    output_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else REPO_DIR / "site"
    output_dir.mkdir(parents=True, exist_ok=True)
    data = palette_data()
    lab = lab_data(data)
    _ = (output_dir / "palette.js").write_text(
        textwrap.dedent(
            f"""\
            // Generated by scripts/generate_site; do not edit.
            window.CHIROPTERA_PALETTES = {json.dumps(data, indent=2)};
            window.CHIROPTERA_PALETTE_LAB = {json.dumps(lab, indent=2)};
        """
        ),
        encoding="utf-8",
    )
    write_palette_css(output_dir / "palette.css", data["dark"]["normal"])
    write_vim_sample(output_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
