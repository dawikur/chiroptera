#!/usr/bin/env python3
# Copyright (c) 2024-2026 Dawid Kurek <hello@dawikur.dev>
"""CLI tool for viewing chiroptera color palettes.

This script allows viewing generated color palettes with customizable
output formatting. It displays both flat palette structure and
hierarchical scheme structure.

Example usage:
    python bin/chiroptera --dark --hard
    python bin/chiroptera --light -n "red.bright"
    python bin/chiroptera --dark -f "{esc}[48;2;{r};{g};{b}m  {esc}[0m {name}"
"""

from __future__ import annotations

import argparse
import re
import sys
import textwrap
from pathlib import Path
from typing import Optional, cast

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from chiroptera.palette import (  # pylint: disable=wrong-import-position
    Contrast,
    Mode,
    Palette,
)
from chiroptera.scheme import Scheme  # pylint: disable=wrong-import-position
from chiroptera.utils import (  # pylint: disable=wrong-import-position
    format_lines,
    palette_tokens,
)


def args_parse() -> argparse.Namespace:
    """Parse command line arguments.

    Returns:
        Parsed arguments namespace with mode, contrast, name filter, and format
    """
    palette = Palette(Mode.DARK, Contrast.NORMAL).add_rgb()

    placeholders = '''
    {name} e.g. "bg" or "fg.normal"'''

    for key in palette["bg"]:
        placeholder = f"{{{key}}}"
        example = palette["bg"][key]

        placeholders += f'''
    {placeholder:6} e.g. "{example}"'''

    placeholders += textwrap.dedent(
        """

        {{esc}} "\\033" escape character

    example (palette):
        {esc}[48;2;{r};{g};{b}m        {esc}[0m {name}

    example (scheme):
        {esc}[48;2;{r};{g};{b}m        {esc}[0m {name}

    """
    )

    parser = argparse.ArgumentParser(
        description="Chiroptera color scheme",
        formatter_class=argparse.RawTextHelpFormatter,
    )

    flavour = parser.add_mutually_exclusive_group(required=True)
    _ = flavour.add_argument("--light", help="use light flavour", action="store_true")
    _ = flavour.add_argument("--dark", help="use dark flavour", action="store_true")

    contrast = parser.add_mutually_exclusive_group(required=False)
    _ = contrast.add_argument("--hard", help="use hard contrast", action="store_true")
    _ = contrast.add_argument("--soft", help="use soft contrast", action="store_true")

    _ = parser.add_argument(
        "-n", "--name", help="regexp to be used for filtering", default=".*"
    )

    _ = parser.add_argument(
        "-f",
        "--format",
        default="{name} = {hex}",
        help="""format to be used for printing

default:
    {name} = {hex}

placeholders:"""
        + placeholders,
    )

    _ = parser.add_argument(
        "-d", "--debug", help="print debug informations", action="store_true"
    )

    _ = parser.add_argument(
        "--template",
        type=Path,
        help="template file to render with the selected palette",
    )
    _ = parser.add_argument(
        "--output", type=Path, help="output path; defaults to stdout with --template"
    )

    args = parser.parse_args()
    if (
        cast(Optional[Path], args.output) is not None
        and cast(Optional[Path], args.template) is None
    ):
        parser.error("--output must be used with --template")
    return args


def main(args: argparse.Namespace) -> int:
    """Render a template or print generated palette colors.

    Args:
        args: Parsed command line arguments

    Returns:
        Exit code (0 for success)
    """

    mode = Mode.DARK if cast(bool, args.dark) else Mode.LIGHT
    contrast = (
        Contrast.HARD
        if cast(bool, args.hard)
        else Contrast.SOFT if cast(bool, args.soft) else Contrast.NORMAL
    )

    palette = Palette(mode, contrast).add_rgb()
    scheme = Scheme(palette).add_rgb()

    if cast(Optional[Path], args.template) is not None:
        tokens = palette_tokens(palette, scheme, mode, contrast)
        rendered = "".join(
            format_lines(cast(Path, args.template).read_text().splitlines(True), tokens)
        )
        if cast(Optional[Path], args.output) is None:
            _ = sys.stdout.write(rendered)
        else:
            _ = cast(Path, args.output).write_text(rendered)
        return 0

    re_name = re.compile(cast(str, args.name))
    output_format = cast(str, args.format)

    # Print palette colors (flat structure)
    for name in palette:
        if not re_name.search(name):
            continue

        color = palette[name]

        output = output_format.replace("{name}", name)
        for key in color:
            output = output.replace(f"{{{key}}}", str(color[key]))

        output = output.replace("{esc}", "\033")

        print(output)

    # Print scheme colors (hierarchical structure with dot notation)
    for category in scheme:
        for color_name in scheme[category]:
            name = f"{category}.{color_name}"

            if not re_name.search(name):
                continue

            color = scheme[category][color_name]

            output = output_format.replace("{name}", name)
            for key in color:
                output = output.replace(f"{{{key}}}", str(color[key]))

            output = output.replace("{esc}", "\033")

            print(output)

    return 0


if __name__ == "__main__":
    ARGS = args_parse()

    sys.exit(main(ARGS))
